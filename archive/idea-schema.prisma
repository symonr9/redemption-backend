generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Define the enums
enum Role {
  ADMIN
  USER
  GUEST
}

enum BeaconType {
  ARCHIVED
  MEETING
  SPIRITUAL_CONVERSATION
  PRAYER_NEED
  SHARING_GOSPEL
  INVITED_TO_CHURCH
  OFFERED_HELP
  ATTENDED_EVENT_TOGETHER
  GAVE_TESTIMONY
  FOLLOWED_UP
}

enum BeaconLogTag {
  FRIENDSHIP
  SHARED_GOSPEL
  SHARED_FAITH
  PRAYED_TOGETHER
  SCRIPTURE_STUDY
  ENCOURAGEMENT
  ADDRESSED_DOUBTS
  ACTS_OF_SERVICE
  ATTENDED_CHURCH
  SHARED_PERSONAL_STRUGGLES
  DISCUSSED_PURPOSE
  FOLLOWED_UP
  INVITED_TO_EVENT
  SHARED_TESTIMONY
  SHARED_RESOURCES
  INVITED_TO_SMALL_GROUP
  INVITED_TO_SERVE
  EXPLORED_BELIEFS
  LISTENED_WELL
  OFFERED_COMFORT
  ADDRESSED_MISCONCEPTIONS
  OTHER
  DISCIPLESHIP
  WORSHIP
  SALVATION_EXPERIENCE
}

enum OneStage {
  DISCIPLE
  NEW_BELIEVER
  SEEKING
  CURIOUS
  FRIENDLY
  APATHETIC
  HOSTILE
}

enum OneFactType {
  BACKGROUND
  FAMILY
  LIKES
  DISLIKES
  WORK
  HOBBIES
  EDUCATION
  SPIRITUAL_BELIEFS
  LIFE_GOALS
  FAVORITE
  FAITH_BACKGROUND
  COMMON_GROUND
  PRAYER_POINT
}

enum ActionStepType {
  SHARE_GOSPEL
  SHARE_TESTIMONY
  INVITE_TO_EVENT
  SPIRITUAL_CONVERSATION
  OFFER_PRAYER
  INVITE_TO_GROUP
  ENCOURAGEMENT
  DISCUSS_SCRIPTURE
  HOST_AT_HOME
  SHARE_DEVOTIONAL
  PROVIDE_BIBLICAL_COUNSEL
  CONNECT_WITH_OTHER_CHRISTIANS
  SHARE_WORSHIP_MUSIC
  BUILD_RAPPORT
  SERVE
  OTHER
}

enum StoryType {
  PERSONAL
  GODS
}

enum StoryChapterType {
  BACKGROUND
  SEEKING
  CURIOUS
  SALVATION_EXPERIENCE
  STRUGGLE
  HIGHLIGHT
  LOWLIGHT
  MISC
  GROWING_IN_FAITH
  CREATION
  SIN
  OLD_TESTAMENT
  JESUS
  RESURRECTION
  CRUCIFIXION
  CHURCH
  CHOSEN_PEOPLE
  JESUS_MINISTRY
  SCRIPTURE_HIGHLIGHT
  CHARACTER
}

enum PromptType {
  NORMAL
}

enum AppIcon {
  MAN1
  BIRD
  CHERRIES
  CHRIST
  CHURCH
  CHURCH_VALENTINES
  CITY
  CROSS_CHURCH
  GLOBE
  PRAYER
  TREE
  SKULL
  NETWORK_PEOPLE
  ARROW_BACK
  EDIT
}

// Define the models
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role
  icon      AppIcon
  createdAt DateTime @default(now())

  // Relations
  beacons      Beacon[]
  oneFacts     OneFact[]
  actionSteps  ActionStep[]
  stories      Story[]
  prompts      Prompt[]
}

model One {
  id           String     @id @default(uuid())
  name         String
  icon         AppIcon
  stage        OneStage
  prayingSince DateTime?
  hidden       Boolean
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  // Relations
  actionSteps ActionStep[]
  facts       OneFact[]
}

model OneFact {
  id       String     @id @default(uuid())
  oneId    String
  one      One        @relation(fields: [oneId], references: [id])
  notes    String
  icon     AppIcon
  priority Int
  type     OneFactType
}

model ActionStep {
  id          String         @id @default(uuid())
  notes       String
  oneId       String
  one         One            @relation(fields: [oneId], references: [id])
  isComplete  Boolean
  targetDate  DateTime?
  type        ActionStepType
}

model Beacon {
  id            String       @id @default(uuid())
  name          String
  message       String?
  userId        String
  oneId         String?
  priority      Int
  type          BeaconType
  activeUntil   DateTime?
  shareOneName  Boolean      @default(false)
  shareOwnName  Boolean      @default(true)
  user          User         @relation(fields: [userId], references: [id])
  one           One?         @relation(fields: [oneId], references: [id])

  // Relations
  beaconLogs   BeaconLog[]
  activities   BeaconActivity[]
}

model BeaconActivity {
  id        String   @id @default(uuid())
  note      String
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  beaconId  String
  beacon    Beacon   @relation(fields: [beaconId], references: [id])
}

model BeaconLog {
  id        String       @id @default(uuid())
  note      String
  date      DateTime
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  beaconId  String
  beacon    Beacon       @relation(fields: [beaconId], references: [id])
  tags      BeaconLogTag[]
}

model BeaconTemplate {
  id      String    @id @default(uuid())
  name    String
  message String
  icon    AppIcon
  type    BeaconType
}

model Prompt {
  id       String     @id @default(uuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  question String
  response String
  type     PromptType
}

model Story {
  id     String    @id @default(uuid())
  userId String
  user   User      @relation(fields: [userId], references: [id])
  title  String
  type   StoryType
  icon   AppIcon

  // Relations
  chapters    StoryChapter[]
  activities  StoryActivity[]
}

model StoryActivity {
  id            String   @id @default(uuid())
  note          String
  date          DateTime
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  storyId       String
  story         Story    @relation(fields: [storyId], references: [id])
  openedChapters Int
  totalChapters  Int
}

model StoryChapter {
  id            String          @id @default(uuid())
  storyId       String
  story         Story           @relation(fields: [storyId], references: [id])
  chapterType   StoryChapterType
  title         String
  content       String
  questions     String[]
  icon          AppIcon
  order         Int
  isEssential   Boolean
}
