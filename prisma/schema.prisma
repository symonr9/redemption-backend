// Prisma schema for SQLite

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model One {
  id           String      @id @default(cuid())  // Use cuid for generating unique IDs
  name         String
  icon         String      // Stores the enum key string for AvatarIcon
  stage        Int    // Enum for OneStage
  category     Int // Enum for OneCategory
  prayingSince DateTime?
  hidden       Boolean     @default(false)
  userId       String
  user         User        @relation(fields: [userId], references: [id]) // Foreign key relation
}

model User {
  id   String  @id @default(cuid())
  name String
  ones One[]   // One-to-many relation with One
}