// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  passwordHash         String
  oauthProvider        String?
  oauthId              String?
  role                 Int     @default(1)
  description          String?
  ones                 One[]
  notificationsEnabled Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  Prayer               Prayer[]
  Notification         Notification[]
  Signup               Signup[]
  Participant          Participant[]
}

model One {
  id              String           @id @default(cuid())
  name            String
  totalMeetings   Int
  nextMeetingDate DateTime?
  meetingHistory  MeetingHistory[]
  userId          String
  user            User             @relation(fields: [userId], references: [id])

  Prayer          Prayer[]
}

// Resources Model
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Events Model
model Event {
  id           String        @id @default(cuid())
  title        String
  description  String
  location     String
  startDate    DateTime
  endDate      DateTime
  type         String
  organization String
  participants Participant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  Signup Signup[]
}

// Participant (for Events and Mission Trips)
model Participant {
  id            String       @id @default(cuid())
  status        String
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id])
  missionTripId String?
  missionTrip   MissionTrip? @relation(fields: [missionTripId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
}

// Mission Trips Model
model MissionTrip {
  id             String        @id @default(cuid())
  title          String
  description    String
  location       String
  departureDate  DateTime
  returnDate     DateTime
  availableSpots Int
  participants   Participant[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  Signup Signup[]
}

// Notifications Model
model Notification {
  id        String   @id @default(cuid())
  message   String
  sentAt    DateTime
  status    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Signups Model
model Signup {
  id            String       @id @default(cuid())
  type          String
  status        String
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id])
  missionTripId String?
  missionTrip   MissionTrip? @relation(fields: [missionTripId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Prayers Model
model Prayer {
  id             String          @id @default(cuid())
  prayerCount    Int
  lastPrayedAt   DateTime?
  prayerRequests PrayerRequest[]
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  oneId          String
  one            One             @relation(fields: [oneId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PrayerRequest {
  id        String   @id @default(cuid())
  request   String
  createdAt DateTime @default(now())
  prayerId  String
  prayer    Prayer   @relation(fields: [prayerId], references: [id])
}

// Meeting History Model
model MeetingHistory {
  id               String   @id @default(cuid())
  meetingDate      DateTime
  notes            String?
  decisionForJesus Boolean
  oneId            String
  one              One      @relation(fields: [oneId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}