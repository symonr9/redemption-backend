// Prisma schema for SQLite

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model One {
  id              String       @id @default(cuid()) // Use cuid for generating unique IDs
  name            String
  icon            String       @default("User")
  stage           Int          @default(5) // Friendly
  category        Int          @default(2) // Close Friend
  knownSince      DateTime?
  gospelChecklist String? // Comma separated list of Ints
  hidden          Boolean      @default(false)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  beacons         Beacon[]
  actionSteps     ActionStep[]
  oneNotes        OneNote[]
  christians      Christian[]
  gospelSteps     GospelStep[]
}

model ActionStep {
  id           String    @id @default(cuid())
  notes        String?
  isComplete   Boolean   @default(false)
  targetDate   DateTime?
  lastModified DateTime  @default(now())
  type         Int       @default(17) // Take out to Coffee
  oneId        String
  one          One       @relation(fields: [oneId], references: [id], onDelete: Cascade)
}

model OneNote {
  id    String   @id @default(cuid())
  date  DateTime @default(now())
  type  Int      @default(1)
  notes String
  oneId String
  one   One      @relation(fields: [oneId], references: [id], onDelete: Cascade)
}

model GospelStep {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  type       Int      @default(1) // SpiritualConversations
  layoutType Int      @default(1) // Binary
  notes      String?
  nextSteps  String?
  rating     Int      @default(0)
  oneId      String
  one        One      @relation(fields: [oneId], references: [id], onDelete: Cascade)
}

model Christian {
  id               String    @id @default(cuid())
  name             String
  oneCategory      Int       @default(21) // Friend
  category         Int       @default(2) // Close Friend
  icon             String    @default("User")
  oneKnownSince    DateTime?
  knownSince       DateTime?
  notes            String?
  mutualInterests  String?
  lastPrayedFor    DateTime?
  lastReachedOutTo DateTime?
  timesPrayed      Int       @default(0)
  timesReachedOut  Int       @default(0)
  oneId            String
  one              One       @relation(fields: [oneId], references: [id], onDelete: Cascade)
}

model Beacon {
  id           String           @id @default(cuid())
  name         String
  message      String?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneId        String
  one          One?             @relation(fields: [oneId], references: [id], onDelete: Cascade)
  priority     Int              @default(2) // Normal
  type         Int              @default(1) // Meeting
  activeUntil  DateTime?
  tags         String? // Comma Separated String of Ints
  shareOwnName Boolean          @default(true)
  activities   BeaconActivity[]
}

model BeaconActivity {
  id       String   @id @default(cuid())
  note     String?
  date     DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beaconId String
  Beacon   Beacon   @relation(fields: [beaconId], references: [id], onDelete: Cascade)
}

model GlobalBeaconActivity {
  id           String       @id @default(cuid())
  note         String?
  date         DateTime     @default(now())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  beaconId     String
  GlobalBeacon GlobalBeacon @relation(fields: [beaconId], references: [id], onDelete: Cascade)
}

model GlobalBeacon {
  id          String                 @id @default(cuid())
  name        String
  message     String?
  priority    Int                    @default(2) // Normal
  type        Int                    @default(1) // New Believers
  activeUntil DateTime?
  tags        String? // Comma Separated String of Ints
  shareOwnName Boolean          @default(true)
  activities  GlobalBeaconActivity[]
}

model StoryChapter {
  id             String   @id @default(cuid())
  storyId        String?
  type           Int      @default(1)
  title          String
  content        String?
  originalPrompt String?
  questions      String // Comma Separated String of Strings
  icon           String   @default("Book")
  order          Int      @default(1)
  tags           String? // Comma Separated String of Ints
  names          String // Comma Separated String of Strings
  quality        Int      @default(5)
  userId         String
  lastModified   DateTime @default(now())
  created        DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String                 @id @default(cuid())
  name                      String
  email                     String?
  role                      Int                    @default(2) // User
  createdAt                 DateTime               @default(now())
  icon                      String                 @default("User")
  refreshToken              String
  lastRefreshDate           DateTime               @default(now())
  lastPartitionDate         DateTime?
  extraPartitionCount       Int                    @default(5)
  lastExtraPartitionGranted DateTime?
  ones                      One[] // One-to-many relation with One
  beacons                   Beacon[]
  beaconActivities          BeaconActivity[]
  globalBeaconActivities    GlobalBeaconActivity[]
  chapters                  StoryChapter[]
  log                       Log[]
}

model Log {
  id        String   @id @default(cuid())
  type      Int      @default(1)
  createdAt DateTime @default(now())
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
