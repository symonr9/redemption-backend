generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum PrayerType {
  FOR_ONE
  FOR_CITY_MINISTRY
  FOR_THE_WORLD
}

enum PrayerBeaconType {
  TO_COMMUNITY
  TO_PRAYER_GROUP
  TO_LEADERSHIP_TEAM
}

enum MeetingTag {
  FRIENDSHIP
  SHARED_GOSPEL
  SHARED_FAITH
  PRAYED_TOGETHER
  SCRIPTURE_STUDY
  ENCOURAGEMENT
  ADDRESSED_DOUBTS
  ACTS_OF_SERVICE
  ATTENDED_CHURCH
  SHARED_PERSONAL_STRUGGLES
  DISCUSSED_PURPOSE
  FOLLOWED_UP
  INVITED_TO_EVENT
  SHARED_TESTIMONY
  SHARED_RESOURCES
  INVITED_TO_SMALL_GROUP
  INVITED_TO_SERVE
  EXPLORED_BELIEFS
  LISTENED_WELL
  OFFERED_COMFORT
  ADDRESSED_MISCONCEPTIONS
  OTHER
  DISCIPLESHIP
  WORSHIP
}

enum Location {
  HOME
  CHURCH
  COFFEE
  BREAKFAST
  LUNCH
  DINNER
  PARK
  WORK
  RECREATION
  ONLINE
  GYM
  OUTDOORS
  TRIP
}

enum OneStage {
  DISCIPLE
  NEW_BELIEVER
  SEEKING
  CURIOUS
  APATHETIC
  HOSTILE
}

enum OneFactType {
  BACKGROUND
  FAMILY
  LIKES
  DISLIKES
  WORK
  HOBBIES
  EDUCATION
  SPIRITUAL_BELIEFS
  LIFE_GOALS
  FAVORITE
  FAITH_BACKGROUND
  COMMON_GROUND
  PRAYER_POINT
}

enum ActionStepType {
  SHARE_GOSPEL
  SHARE_TESTIMONY
  INVITE_TO_EVENT
  SPIRITUAL_CONVERSATION
  OFFER_PRAYER
  INVITE_TO_GROUP
  ENCOURAGEMENT
  DISCUSS_SCRIPTURE
  HOST_AT_HOME
  SHARE_DEVOTIONAL
  PROVIDE_BIBLICAL_COUNSEL
  CONNECT_WITH_OTHER_CHRISTIANS
  SHARE_WORSHIP_MUSIC
  BUILD_RAPPORT
  SERVE
  OTHER
}

enum StoryType {
  YOURS
  GODS
}

enum StoryChapterType {
  // Your Story
  SEEKING
  CURIOUS
  SALVATION_EXPERIENCE
  STRUGGLE
  HIGHLIGHT
  LOWLIGHT
  MISC

  // God's Story
  CORE_GOSPEL
  SCRIPTURE_HIGHLIGHT
  CHARACTER
}

enum JournalEntryType {
  PRAYER
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum AppIcon {
  MAN1
}

enum AvatarIcon {
  MAN1
  MAN2
  MAN3
  MAN4
  MAN5
  MAN6
  MAN7
  WOMAN1
  WOMAN2
  WOMAN3
  WOMAN4
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  prayers      Prayer[]
  meetings     Meeting[]
  actionSteps  ActionStep[]
  journalEntries JournalEntry[]
  godsStories  GodsStory[]
  yourStories  YourStory[]
  prompts      Prompt[]
}

model ActionStep {
  id          String        @id @default(cuid())
  notes       String
  oneId       String
  isComplete  Boolean
  targetDate  DateTime?
  type        ActionStepType

  one         One           @relation(fields: [oneId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
}

model GodsStory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model JournalEntry {
  id        String           @id @default(cuid())
  type      String
  details   String
  userId    String
  entryType JournalEntryType
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])
}

model Meeting {
  id          String      @id @default(cuid())
  meetingDate DateTime
  notes       String
  oneId       String
  userId      String
  tags        MeetingTag[]
  location    Location

  one         One         @relation(fields: [oneId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

model One {
  id            String        @id @default(cuid())
  name          String
  icon          AvatarIcon
  stage         OneStage
  nextMeetingAt DateTime?
  prayingSince  DateTime
  hidden        Boolean

  meetings      Meeting[]
  prayers       Prayer[]
  actionSteps   ActionStep[]
  facts         OneFact[]

  userId        String
  user          User          @relation(fields: [userId], references: [id])
}

model OneFact {
  id       String     @id @default(cuid())
  oneId    String
  notes    String
  icon     AppIcon
  priority Priority
  type     OneFactType

  one      One        @relation(fields: [oneId], references: [id])
}

model Prayer {
  id           String        @id @default(cuid())
  name         String
  lastPrayedAt DateTime?
  userId       String
  oneId        String?
  type         PrayerType

  user         User          @relation(fields: [userId], references: [id])
  one          One?          @relation(fields: [oneId], references: [id])
  requests     PrayerRequest[]
}

model PrayerBeacon {
  id          String            @id @default(cuid())
  name        String
  message     String
  userId      String
  oneId       String
  meetingId   String
  responses   String[]
  targetDate  DateTime?
  priority    Priority

  user        User              @relation(fields: [userId], references: [id])
  one         One               @relation(fields: [oneId], references: [id])
  meeting     Meeting           @relation(fields: [meetingId], references: [id])
  settings    PrayerBeaconSettings
}

model PrayerBeaconSettings {
  id           String          @id @default(cuid())
  name         String
  shareOneName Boolean
  shareOwnName Boolean
  type         PrayerBeaconType

  beaconId     String
  beacon       PrayerBeacon     @relation(fields: [beaconId], references: [id])
}

model PrayerRequest {
  id        String     @id @default(cuid())
  text      String
  createdAt DateTime   @default(now())
  prayerId  String

  prayer    Prayer      @relation(fields: [prayerId], references: [id])
}

model Prompt {
  id        String  @id @default(cuid())
  userId    String
  title     String
  notes     String
  icon      AppIcon
  order     Int

  user      User    @relation(fields: [userId], references: [id])
}

model StoryChapter {
  id          String           @id @default(cuid())
  storyId     String
  chapterType StoryChapterType
  storyType   StoryType
  title       String
  notes       String
  icon        AppIcon
  order       Int

  story       Story            @relation(fields: [storyId], references: [id])
}

model Story {
  id         String          @id @default(cuid())
  userId     String
  type       StoryType
  chapters   StoryChapter[]

  user       User            @relation(fields: [userId], references: [id])
}

model YourStory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
}
