// Prisma schema for SQLite

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model One {
  id              String       @id @default(cuid()) // Use cuid for generating unique IDs
  name            String
  icon            String       @default("User")
  stage           Int          @default(5) // Friendly
  category        Int          @default(2) // Close Friend
  prayingSince    DateTime?    @default(now())
  gospelChecklist String? // Comma separated list of Ints
  hidden          Boolean      @default(false)
  userId          String
  user            User         @relation(fields: [userId], references: [id]) // Foreign key relation
  beacons         Beacon[]
  actionSteps     ActionStep[]
}

model ActionStep {
  id         String    @id @default(cuid())
  notes      String?
  isComplete Boolean   @default(false)
  targetDate DateTime?
  type       Int       @default(17) // Take out to Coffee
  oneId      String
  one        One       @relation(fields: [oneId], references: [id]) // Foreign key relation
}

model Beacon {
  id           String           @id @default(cuid())
  name         String
  message      String?
  userId       String
  user         User             @relation(fields: [userId], references: [id]) // Foreign key relation
  oneId        String
  one          One?             @relation(fields: [oneId], references: [id])
  priority     Int              @default(2) // Normal
  type         Int              @default(1) // Meeting
  activeUntil  DateTime?
  shareOwnName Boolean          @default(true)
  activities   BeaconActivity[]
}

model BeaconActivity {
  id       String   @id @default(cuid())
  note     String?
  date     DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id]) // Foreign key relation
  beaconId String
  Beacon   Beacon   @relation(fields: [beaconId], references: [id]) // Foreign key relation
}

model StoryChapter {
  id        String  @id @default(cuid())
  storyId   String?
  type      Int     @default(1)
  title     String
  content   String?
  questions String // Comma Separated String of Strings
  icon      String  @default("Book")
  order     Int     @default(1)
  tags      String? // Comma Separated String of Ints
  names     String // Comma Separated String of Strings
  quality   Int     @default(5)
  userId    String
  User      User    @relation(fields: [userId], references: [id])
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String?
  role             Int              @default(2) // User
  createdAt        DateTime         @default(now())
  icon             String           @default("User")
  refreshToken     String
  lastRefreshDate  DateTime         @default(now())
  ones             One[] // One-to-many relation with One
  beacons          Beacon[]
  beaconActivities BeaconActivity[]
  chapters         StoryChapter[]
  log              Log[]
}

model Log {
  id        String   @id @default(cuid())
  type      Int      @default(1)
  createdAt DateTime @default(now())
  details   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id]) // Foreign key relation
}
